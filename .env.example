# ==========================================
# Forever E-Commerce Admin - environment template
# NEXT_PUBLIC_* values are inlined at build time; set them before `npm run build`.
# ==========================================

# Backend REST API URL  [required for production builds]
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Customer storefront URL (cross-app link)  [required for production builds]
NEXT_PUBLIC_STORE_URL=http://localhost:5173
